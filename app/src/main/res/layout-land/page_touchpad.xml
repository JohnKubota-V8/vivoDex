<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/touchpad_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp"
    android:visibility="gone">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_glass_trackpad"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="@dimen/glass_card_radius"
        app:cardElevation="@dimen/glass_surface_elevation"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.example.vivodex.TrackpadView
                android:id="@+id/trackpad"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/trackpad_description" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:alpha="0.22"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.18"
                    android:text="vivoDex"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/text_glass_primary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="MOVE  /  TAP  /  SCROLL"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/text_glass_secondary" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/trackpad_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Touchpad"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/text_glass_primary"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_speed"
                    android:layout_width="80dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_glass_button"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:text="1.5x"
                    android:textColor="@color/text_glass_primary"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mouse_left"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="3"
                    android:background="@drawable/bg_glass_button_primary"
                    android:text="Left Click"
                    android:textColor="@color/text_glass_primary"
                    android:textStyle="bold"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_touchpad"
                    app:iconTint="@color/text_glass_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mouse_right"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="2"
                    android:background="@drawable/bg_glass_button"
                    android:text="Right"
                    android:textColor="@color/text_glass_primary"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_keyboard"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_glass_button"
                android:text="Keyboard for External App"
                android:textColor="@color/text_glass_primary"
                app:backgroundTint="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toggle_cursor"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_button"
                    android:contentDescription="@string/toggle_cursor"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_cursor_toggle"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/text_glass_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/blackout_phone_screen"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_button"
                    android:contentDescription="@string/dim_screen"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_brightness_dim"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/text_glass_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/more_controls"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/bg_glass_button"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="More"
                    android:textColor="@color/text_glass_primary"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/zoom_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/zoom_slider"
                    android:text="Zoom"
                    android:textColor="@color/text_glass_primary"
                    android:textStyle="bold" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/zoom_slider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:stepSize="0.1"
                    android:value="1.0"
                    android:valueFrom="0.5"
                    android:valueTo="2.0" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scroll_left"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_button"
                    android:contentDescription="@string/scroll_left"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_arrow_back"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/text_glass_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scroll_up"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_button"
                    android:contentDescription="@string/scroll_up"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_arrow_up"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/text_glass_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scroll_down"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_button"
                    android:contentDescription="@string/scroll_down"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_arrow_down"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/text_glass_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scroll_right"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_button"
                    android:contentDescription="@string/scroll_right"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_arrow_forward"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/text_glass_primary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
