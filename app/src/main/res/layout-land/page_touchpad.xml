<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/touchpad_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp"
    android:visibility="gone">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/deck_surface_raised"
        app:cardCornerRadius="@dimen/glass_card_radius"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glass_trackpad">

            <com.example.vivodex.TrackpadView
                android:id="@+id/trackpad"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/trackpad_description" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:alpha="0.6"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.16"
                    android:text="vivoDex"
                    android:textColor="@color/text_glass_secondary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:letterSpacing="0.12"
                    android:text="MOVE · TAP · SCROLL"
                    android:textColor="@color/text_glass_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_status_dot"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/trackpad_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Display disconnected"
                    android:textColor="@color/text_glass_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_speed"
                    android:layout_width="72dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_glass_button"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="1.5x"
                    android:textAllCaps="false"
                    android:textColor="@color/text_glass_primary"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mouse_left"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.15"
                    android:background="@drawable/bg_glass_button_primary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeMinTextSize="13sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Left click"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text_glass"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mouse_right"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_button"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeMinTextSize="13sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Right click"
                    android:textAllCaps="false"
                    android:textColor="@color/text_glass_primary"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_keyboard"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_control_tile"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:autoSizeMaxTextSize="15sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="Keyboard"
                android:textAllCaps="false"
                android:textColor="@color/text_glass_primary"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toggle_cursor"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_control_tile"
                    android:contentDescription="@string/toggle_cursor"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_cursor_toggle"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/text_glass_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/blackout_phone_screen"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_control_tile"
                    android:contentDescription="@string/dim_screen"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_brightness_dim"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/text_glass_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/more_controls"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/bg_control_tile"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:autoSizeMaxTextSize="15sp"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="More"
                    android:textAllCaps="false"
                    android:textColor="@color/text_glass_primary"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/zoom_controls"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/zoom_slider"
                    android:text="Zoom"
                    android:textColor="@color/text_glass_primary"
                    android:textStyle="bold" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/zoom_slider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:stepSize="0.1"
                    android:value="1.0"
                    android:valueFrom="0.5"
                    android:valueTo="2.0"
                    app:haloColor="@color/deck_accent_dim"
                    app:thumbColor="@color/deck_accent"
                    app:trackColorActive="@color/deck_accent"
                    app:trackColorInactive="@color/deck_stroke" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scroll_left"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_control_tile"
                    android:contentDescription="@string/scroll_left"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_arrow_back"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/text_glass_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scroll_up"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_control_tile"
                    android:contentDescription="@string/scroll_up"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_arrow_up"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/text_glass_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scroll_down"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_control_tile"
                    android:contentDescription="@string/scroll_down"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_arrow_down"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/text_glass_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scroll_right"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_control_tile"
                    android:contentDescription="@string/scroll_right"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_arrow_forward"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/text_glass_primary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
