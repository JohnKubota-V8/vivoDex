<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:scrollbars="none"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SETTINGS"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="@color/text_glass_primary"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_card"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISPLAY POWER"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/text_glass_primary"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/awake_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/text_glass_secondary" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_glass_button">

                    <View
                        android:id="@+id/awake_glass_indicator"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_nav_glass_indicator"
                        android:importantForAccessibility="no" />

                    <RadioGroup
                        android:id="@+id/awake_mode_group"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="4dp">

                        <RadioButton
                            android:id="@+id/awake_auto"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:button="@null"
                            android:gravity="center"
                            android:text="Auto"
                            android:textColor="@color/segment_text_color"
                            android:textStyle="bold" />

                        <RadioButton
                            android:id="@+id/awake_on"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:button="@null"
                            android:gravity="center"
                            android:text="On"
                            android:textColor="@color/segment_text_color"
                            android:textStyle="bold" />

                        <RadioButton
                            android:id="@+id/awake_off"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:button="@null"
                            android:gravity="center"
                            android:text="Off"
                            android:textColor="@color/segment_text_color"
                            android:textStyle="bold" />
                    </RadioGroup>
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass_card"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACCESS SERVICE"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/text_glass_primary"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/auto_disable_accessibility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Auto-disable Accessibility"
                    android:textColor="@color/text_glass_primary"
                    app:thumbTint="@color/switch_thumb_glass"
                    app:trackTint="@color/switch_track_glass" />

                <TextView
                    android:id="@+id/auto_disable_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Turns off 10 minutes after leaving vivoDex"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/text_glass_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/disable_accessibility_now"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:text="Turn Off Accessibility Now"
                    android:textColor="@color/deck_danger"
                    android:background="@drawable/bg_glass_button"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
