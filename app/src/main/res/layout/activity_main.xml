<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ambient_mesh">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:title="vivoDex"
        app:titleCentered="false"
        app:titleTextColor="@color/text_glass_primary"
        app:subtitle="Desktop Mode"
        app:subtitleTextColor="@color/text_glass_secondary"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation_container">

        <!-- ==================== DISPLAY & APPS PAGE ==================== -->
        <ScrollView
            android:id="@+id/display_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Display Connection Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_display_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_glass_card"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardCornerRadius="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/display_icon"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_display"
                                app:tint="@color/white"
                                android:contentDescription="Display Icon" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="14dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="External Display"
                                    android:textColor="@color/text_glass_primary"
                                    android:textAppearance="?attr/textAppearanceTitleMedium"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/display_status"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="No external display connected"
                                    android:textColor="@color/text_glass_secondary"
                                    android:textAppearance="?attr/textAppearanceBodyMedium" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/glass_stroke"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="14dp" />

                        <TextView
                            android:id="@+id/selected_display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Target: No target display selected"
                            android:textColor="@color/text_glass_primary"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/display_details"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/text_glass_secondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/select_display"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="14dp"
                            android:text="Switch Target Display"
                            android:textColor="@color/text_glass_primary"
                            android:background="@drawable/bg_glass_button"
                            app:backgroundTint="@null"
                            app:icon="@drawable/ic_display"
                            app:iconTint="@color/white" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Accessibility Status Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_accessibility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_glass_card"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardCornerRadius="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/accessibility_icon"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_warning"
                                app:tint="?attr/colorError"
                                android:contentDescription="Accessibility status" />

                            <TextView
                                android:id="@+id/accessibility_status"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="14dp"
                                android:text="Accessibility Service: Disabled"
                                android:textColor="@color/text_glass_primary"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Required to draw virtual cursor and send mouse clicks to secondary display."
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/text_glass_secondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/open_accessibility_settings"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="14dp"
                            android:text="Enable Accessibility Service"
                            android:textColor="@color/white"
                            android:background="@drawable/bg_glass_button"
                            app:backgroundTint="@null" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Favorite Apps Launcher Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_glass_card"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardCornerRadius="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Favorite Apps Launcher"
                            android:textColor="@color/text_glass_primary"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Tap an app icon to launch directly onto the target display"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/text_glass_secondary" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/favorite_apps"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/select_app"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="Add App"
                                android:textColor="@color/text_glass_primary"
                                android:background="@drawable/bg_glass_button"
                                app:backgroundTint="@null"
                                app:icon="@drawable/ic_add"
                                app:iconTint="@color/white" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/remove_favorite"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginStart="8dp"
                                android:text="Remove"
                                android:visibility="gone"
                                android:textColor="#FF5252"
                                android:background="@drawable/bg_glass_button"
                                app:backgroundTint="@null" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/launch_app"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="10dp"
                            android:text="Launch Selected App"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:background="@drawable/bg_glass_button_primary"
                            app:backgroundTint="@null"
                            app:icon="@drawable/ic_display"
                            app:iconTint="@color/white" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/launch_on_phone"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:text="Open Selected App on Phone"
                            android:textColor="@color/text_glass_primary"
                            android:background="@drawable/bg_glass_button"
                            app:backgroundTint="@null" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- ==================== TOUCHPAD PAGE (OBSIDIAN DARK FULL SCREEN) ==================== -->
        <LinearLayout
            android:id="@+id/touchpad_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Touchpad Controls Bar (Status & Quick Glass Actions) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/trackpad_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Touchpad"
                    android:textColor="@color/text_glass_primary"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <!-- Speed Toggle Chip -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_speed"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1.25"
                    android:text="1.5x"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_glass_button"
                    app:backgroundTint="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    app:icon="@drawable/ic_speed"
                    app:iconTint="@color/white"
                    app:iconSize="16dp" />

                <!-- Toggle Cursor Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toggle_cursor"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="0.75"
                    android:layout_marginStart="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:background="@drawable/bg_glass_button"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_cursor_toggle"
                    app:iconTint="@color/white"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:contentDescription="Toggle Cursor" />

                <!-- Blackout / Dim Phone Screen Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/blackout_phone_screen"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="0.75"
                    android:layout_marginStart="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:background="@drawable/bg_glass_button"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_brightness_dim"
                    app:iconTint="@color/white"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:contentDescription="Dim Screen" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/more_controls"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1.1"
                    android:layout_marginStart="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="More"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_glass_button"
                    app:backgroundTint="@null" />
                </LinearLayout>
            </LinearLayout>

            <!-- Expansive Full-Screen Obsidian Glass Trackpad Surface -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_trackpad"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardCornerRadius="22dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.example.vivodex.TrackpadView
                        android:id="@+id/trackpad"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Centered watermark instructions -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:alpha="0.20">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="vivoDex"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textStyle="bold"
                            android:letterSpacing="0.25"
                            android:textColor="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="1 finger: move &amp; tap • 2 fingers: scroll &amp; right-click"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/text_glass_secondary" />
            </LinearLayout>

        </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/zoom_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zoom"
                    android:textColor="@color/text_glass_primary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="-"
                    android:textColor="@color/text_glass_secondary"
                    android:textSize="20sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/zoom_slider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="8dp"
                    android:value="1.0"
                    android:valueFrom="0.5"
                    android:valueTo="2.0"
                    android:stepSize="0.1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textColor="@color/text_glass_secondary"
                    android:textSize="20sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_keyboard"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Keyboard for External App"
                android:textColor="@color/text_glass_primary"
                android:background="@drawable/bg_glass_button"
                app:backgroundTint="@null" />

            <!-- Scroll Gestures Bar (Icon-Only Glass Buttons: Up, Down, Left, Right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scroll_up"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:background="@drawable/bg_glass_button"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_arrow_up"
                    app:iconTint="@color/white"
                    app:iconSize="20dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:contentDescription="Scroll Up" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scroll_down"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:background="@drawable/bg_glass_button"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_arrow_down"
                    app:iconTint="@color/white"
                    app:iconSize="20dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:contentDescription="Scroll Down" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scroll_left"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:background="@drawable/bg_glass_button"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_arrow_back"
                    app:iconTint="@color/white"
                    app:iconSize="20dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:contentDescription="Scroll Left" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scroll_right"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:background="@drawable/bg_glass_button"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_arrow_forward"
                    app:iconTint="@color/white"
                    app:iconSize="20dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:contentDescription="Scroll Right" />
            </LinearLayout>

            <!-- Physical Glass Mouse Buttons (Left Click & Right Click) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mouse_left"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="3"
                    android:text="Left Click"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:background="@drawable/bg_glass_button_primary"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_touchpad"
                    app:iconTint="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mouse_right"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="2"
                    android:layout_marginStart="8dp"
                    android:text="Right Click"
                    android:textColor="@color/text_glass_primary"
                    android:background="@drawable/bg_glass_button"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </LinearLayout>

        <include layout="@layout/page_settings" />
    </FrameLayout>

    <!-- Bottom Navigation (Frosted Glass Style) -->
    <FrameLayout
        android:id="@+id/bottom_navigation_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/nav_glass_indicator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_nav_glass_indicator"
            android:importantForAccessibility="no" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:itemActiveIndicatorStyle="@style/Widget.VivoDex.BottomNavigation.ActiveIndicator"
            app:itemIconTint="@color/nav_item_color"
            app:itemTextColor="@color/nav_item_color"
            app:itemRippleColor="#20FFFFFF"
            app:menu="@menu/bottom_nav_menu" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
