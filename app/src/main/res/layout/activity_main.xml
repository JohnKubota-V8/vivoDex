<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ambient_mesh">

    <FrameLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="@dimen/page_horizontal_padding"
            android:fontFamily="sans-serif"
            android:text="vivoDex"
            android:textColor="@color/text_glass_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/toolbar_context"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/page_horizontal_padding"
            android:text="@string/control_deck"
            android:textColor="@color/text_glass_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <ScrollView
            android:id="@+id/display_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="@dimen/page_horizontal_padding"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/page_horizontal_padding"
            android:paddingBottom="24dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_display_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/deck_surface_raised"
                    app:cardCornerRadius="@dimen/glass_card_radius"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_display_icon_panel">

                                <ImageView
                                    android:id="@+id/display_icon"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_display"
                                    app:tint="@color/text_glass_secondary" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/display_status"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="No external display"
                                    android:textColor="@color/text_glass_primary"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/display_status_detail"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Connect USB-C to a monitor or TV"
                                    android:textColor="@color/text_glass_secondary"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_target_panel"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:letterSpacing="0.08"
                                    android:text="TARGET"
                                    android:textColor="@color/text_glass_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/selected_display"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="Phone display"
                                    android:textColor="@color/text_glass_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/display_details"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:gravity="end"
                                android:maxLines="2"
                                android:textColor="@color/text_glass_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/select_display"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_glass_button"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Switch display"
                            android:textAllCaps="false"
                            android:textColor="@color/text_glass_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_accessibility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/deck_surface_feature"
                    app:cardCornerRadius="@dimen/glass_card_radius"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/accessibility_icon"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_marginTop="1dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_warning"
                                app:tint="@color/deck_warning" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/accessibility_status"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Accessibility is off"
                                    android:textColor="@color/text_glass_primary"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="Required for the virtual mouse, clicks and gestures on the target display."
                                    android:textColor="@color/text_glass_secondary"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/open_accessibility_settings"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_glass_button_primary"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Enable accessibility"
                            android:textAllCaps="false"
                            android:textColor="@color/button_text_glass"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/deck_surface_raised"
                    app:cardCornerRadius="@dimen/glass_card_radius"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Apps"
                                    android:textColor="@color/text_glass_primary"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Pick one, then choose where to open it"
                                    android:textColor="@color/text_glass_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/select_app"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:layout_marginStart="10dp"
                                android:background="@drawable/bg_glass_button"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Add"
                                android:textAllCaps="false"
                                android:textColor="@color/text_glass_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                app:backgroundTint="@null"
                                app:icon="@drawable/ic_add"
                                app:iconPadding="4dp"
                                app:iconSize="18dp"
                                app:iconTint="@color/text_glass_primary" />
                        </LinearLayout>

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:clipToPadding="false"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/favorite_apps"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/launch_app"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_glass_button_primary"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Launch selected app"
                            android:textAllCaps="false"
                            android:textColor="@color/button_text_glass"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/launch_on_phone"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_glass_button"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Open on phone"
                                android:textAllCaps="false"
                                android:textColor="@color/text_glass_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                app:backgroundTint="@null" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/remove_favorite"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginStart="10dp"
                                android:background="@android:color/transparent"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Remove"
                                android:textAllCaps="false"
                                android:textColor="@color/deck_danger"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                app:backgroundTint="@null" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <include layout="@layout/page_touchpad" />
        <include layout="@layout/page_settings" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/bottom_navigation_container"
        android:layout_width="0dp"
        android:layout_height="84dp"
        android:background="@drawable/bg_bottom_nav"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/nav_glass_indicator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_nav_glass_indicator"
            android:importantForAccessibility="no" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            app:itemActiveIndicatorStyle="@style/Widget.VivoDex.BottomNavigation.ActiveIndicator"
            app:itemIconSize="24dp"
            app:itemIconTint="@color/nav_item_color"
            app:itemPaddingBottom="8dp"
            app:itemPaddingTop="8dp"
            app:itemRippleColor="@color/deck_accent_dim"
            app:itemTextAppearanceActive="@style/Widget.VivoDex.BottomNavigation.Label.Active"
            app:itemTextAppearanceInactive="@style/Widget.VivoDex.BottomNavigation.Label.Inactive"
            app:itemTextColor="@color/nav_item_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
