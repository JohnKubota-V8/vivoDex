<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#24FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="315"
                        android:startColor="#24FFFFFF"
                        android:centerColor="#14FFFFFF"
                        android:endColor="#09FFFFFF" />
                    <corners android:radius="10dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#34FFFFFF" />
                </shape>
            </item>
            <item
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#14FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
