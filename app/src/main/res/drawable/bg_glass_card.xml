<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#38FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="315"
                        android:startColor="#50FFFFFF"
                        android:centerColor="#30FFFFFF"
                        android:endColor="#18FFFFFF" />
                    <corners android:radius="@dimen/glass_card_radius" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/glass_stroke" />
                </shape>
            </item>
            <item
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#38FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="7dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
