<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base pure OLED black background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/canvas_dark" />
        </shape>
    </item>

    <!-- Large soft reflection behind the upper content. -->
    <item
        android:top="-180dp"
        android:right="-120dp"
        android:bottom="240dp"
        android:left="-40dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="420dp"
                android:startColor="#12FFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>

    <item
        android:top="260dp"
        android:left="120dp"
        android:right="-160dp"
        android:bottom="-220dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="360dp"
                android:startColor="#0AFFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
