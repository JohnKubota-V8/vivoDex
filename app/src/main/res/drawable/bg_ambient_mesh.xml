<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Static technical glow over an OLED-black canvas. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/canvas_dark" />
        </shape>
    </item>

    <!-- Large soft reflection behind the upper content. -->
    <item
        android:top="-220dp"
        android:right="-100dp"
        android:bottom="280dp"
        android:left="-80dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="460dp"
                android:startColor="#145FD7F5"
                android:endColor="#00000000" />
        </shape>
    </item>

    <item
        android:top="320dp"
        android:left="80dp"
        android:right="-160dp"
        android:bottom="-220dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="360dp"
                android:startColor="#0C50647B"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
