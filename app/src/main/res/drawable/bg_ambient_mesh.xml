<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle neutral reflections over an OLED-black canvas. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/canvas_dark" />
        </shape>
    </item>

    <!-- Large soft reflection behind the upper content. -->
    <item
        android:top="-180dp"
        android:right="-150dp"
        android:bottom="260dp"
        android:left="-30dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="440dp"
                android:startColor="#14FFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>

    <item
        android:top="300dp"
        android:left="100dp"
        android:right="-160dp"
        android:bottom="-220dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="360dp"
                android:startColor="#09FFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
