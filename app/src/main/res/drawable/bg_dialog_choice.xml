<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="160"
    android:exitFadeDuration="100">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/deck_surface_selected" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/deck_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/deck_surface_inset" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/deck_stroke" />
        </shape>
    </item>
</selector>
