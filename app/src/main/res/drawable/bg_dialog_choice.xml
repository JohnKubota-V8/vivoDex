<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="160"
    android:exitFadeDuration="100">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#2CFFFFFF"
                android:endColor="#18FFFFFF" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="#64FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0EFFFFFF" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="#28FFFFFF" />
        </shape>
    </item>
</selector>
