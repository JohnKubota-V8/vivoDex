<resources>
    <!-- Base application theme configured for monochrome Liquid Glass. -->
    <style name="Base.Theme.VivoDex" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/deck_accent</item>
        <item name="colorSecondary">@color/text_glass_secondary</item>
        <item name="colorSecondaryContainer">@color/deck_accent_dim</item>
        <item name="colorOnSecondaryContainer">@color/text_glass_primary</item>
        <item name="android:statusBarColor">@color/canvas_dark</item>
        <item name="android:navigationBarColor">@color/canvas_dark</item>
        <item name="android:windowBackground">@color/canvas_dark</item>

        <!-- Compact glass dialog theme -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.VivoDex.Dialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.VivoDex.Dialog</item>
    </style>

    <style name="ThemeOverlay.VivoDex.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/canvas_surface</item>
        <item name="colorOnSurface">@color/text_glass_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_glass_secondary</item>
        <item name="colorPrimary">@color/deck_accent</item>
        <item name="colorSecondary">@color/deck_accent</item>
        <item name="colorControlActivated">@color/deck_accent</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Widget.VivoDex.Dialog.Title</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.VivoDex.Dialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.VivoDex.Dialog.Button.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.VivoDex.Dialog.Button.Negative</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.VivoDex.Dialog</item>
        <item name="android:backgroundDimAmount">0.72</item>
    </style>

    <style name="ShapeAppearanceOverlay.VivoDex.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Widget.VivoDex.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/text_glass_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="Widget.VivoDex.Dialog.Button.Positive" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_glass_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">#25FFFFFF</item>
    </style>

    <style name="Widget.VivoDex.Dialog.Button.Negative" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_glass_secondary</item>
        <item name="rippleColor">#20FFFFFF</item>
    </style>

    <style name="Widget.VivoDex.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="Theme.VivoDex" parent="Base.Theme.VivoDex" />
</resources>
